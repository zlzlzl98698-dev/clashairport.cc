---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import BrandAffCTA from '../components/review/BrandAffCTA.astro';
import { getPrimaryBrand, getRelatedArticles } from '../utils/content';
import type { Brand } from '../data/brands';

interface BreadcrumbItem {
  title: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  breadcrumbs: BreadcrumbItem[];
  date?: string;
  updateDate?: string;
  readingTimeMinutes?: number;
  category?: string;
  coverImage?: string;
  author?: string;
  brand?: Brand;
  showBrandCTA?: boolean;
  pageType?: 'article' | 'collection' | 'website' | 'about';
}

const {
  title,
  description,
  canonical,
  breadcrumbs,
  date = '2026-11-17',
  updateDate = '2026-11-17',
  readingTimeMinutes = 5,
  category = '深度测评',
  coverImage,
  author = 'clash机机评测室',
  brand,
  showBrandCTA = true,
  pageType = 'article',
} = Astro.props;

const currentUrl = canonical || Astro.url.pathname;
const targetBrand = brand || getPrimaryBrand();
const relatedArticles = getRelatedArticles(currentUrl, 4);
---

<BaseLayout
  title={`${title} - clash机机`}
  description={description}
  canonical={canonical}
  ogImage={coverImage}
  ogType={pageType === 'collection' ? 'website' : 'article'}
  pageType={pageType}
  publishDate={date}
  updateDate={updateDate}
  author={author}
  articleSection={category}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <!-- Breadcrumbs -->
    <Breadcrumb items={breadcrumbs} />

    <!-- Article Header Area -->
    <header class="mb-8 pt-2">
      <div class="flex items-center gap-2 mb-3">
        <span class="px-2.5 py-1 text-xs font-bold rounded-md bg-brand-50 text-brand-700 border border-brand-200">
          {category}
        </span>
        <span class="text-xs text-ink-muted">
          发布日期：<time datetime={date}>{date}</time>
        </span>
        <span class="text-xs text-ink-muted hidden sm:inline">
          • 阅读用时约 {readingTimeMinutes} 分钟
        </span>
        <span class="text-xs text-emerald-700 font-semibold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 hidden sm:inline">
          已通过实机核验
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-ink-title tracking-tight leading-tight mb-4">
        {title}
      </h1>

      <p class="text-sm sm:text-base text-ink-body leading-relaxed bg-surface-subtle p-4 rounded-xl border border-surface-border">
        <strong>核心速览：</strong>{description}
      </p>
    </header>

    <!-- 2-Column Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left / Main Article Body (8 cols on lg) -->
      <main class="lg:col-span-8 min-w-0" data-pagefind-body>
        {coverImage && (
          <div class="mb-8 rounded-2xl overflow-hidden border border-surface-border shadow-sm aspect-[16/9] max-h-[420px] bg-slate-900">
            <img
              src={coverImage}
              alt={title}
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
        )}

        <!-- Main slot / Markdown parsed output -->
        <div class="article-prose">
          <slot />
        </div>

        <!-- Commercial CTA Block (Default to 光速云 or current brand) -->
        {showBrandCTA && targetBrand && (
          <BrandAffCTA brand={targetBrand} />
        )}

        <!-- Next Reading / Internal Link cluster -->
        <div class="mt-12 pt-8 border-t border-surface-border">
          <h3 class="text-lg font-bold text-ink-title mb-4">📚 延伸推荐与相关评测</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {relatedArticles.map((rel) => (
              <a
                href={rel.url}
                class="card-base p-4 bg-surface-subtle hover:bg-white hover:border-brand-300 flex flex-col justify-between"
              >
                <div>
                  <span class="text-[10px] font-semibold text-brand-600 uppercase tracking-wider block mb-1">
                    {rel.pillar} / {rel.subtopic || '测评'}
                  </span>
                  <h4 class="text-xs font-bold text-ink-title line-clamp-2 mb-2 hover:text-brand-600 transition-colors">
                    {rel.title}
                  </h4>
                  <p class="text-[11px] text-ink-muted line-clamp-2">
                    {rel.description}
                  </p>
                </div>
                <div class="mt-3 pt-2 border-t border-surface-border/60 text-[11px] text-brand-600 font-semibold flex items-center justify-between">
                  <span>立即阅读</span>
                  <span>→</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </main>

      <!-- Right Sidebar (4 cols on lg) -->
      <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24">
        
        <!-- Primary Brand Sticky Card -->
        <div class="card-base p-5 bg-gradient-to-br from-brand-50/60 to-white border-brand-200">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-lg bg-white border border-brand-200 p-1 flex items-center justify-center flex-shrink-0">
              <img src={targetBrand.logo || '/favicon.svg'} alt={targetBrand.name} class="w-full h-full object-contain" />
            </div>
            <div>
              <span class="text-[10px] font-bold text-brand-700 bg-brand-100 px-1.5 py-0.2 rounded">
                编辑严选首推
              </span>
              <h4 class="text-sm font-bold text-ink-title mt-0.5">{targetBrand.name}</h4>
            </div>
          </div>
          <p class="text-xs text-ink-muted leading-relaxed mb-3">
            {targetBrand.summary.substring(0, 75)}...
          </p>
          <div class="bg-white rounded-lg p-2.5 border border-surface-border mb-3 text-xs flex justify-between items-center">
            <span class="text-ink-muted">入门资费:</span>
            <span class="font-bold text-brand-600 font-mono">{targetBrand.priceDisplay.split(' ')[0]}</span>
          </div>
          <a
            href={targetBrand.affUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="block w-full py-2.5 text-center text-xs font-bold text-white bg-brand-600 hover:bg-brand-700 rounded-lg shadow-sm transition-all"
          >
            直达 {targetBrand.name} 官网特惠 →
          </a>
        </div>

        <!-- Quick Topic Navigation -->
        <div class="card-base p-5 bg-white">
          <h4 class="text-xs font-bold text-ink-title uppercase tracking-wider mb-3 pb-2 border-b border-surface-border">
            🧭 全站重点专题索引
          </h4>
          <ul class="space-y-2 text-xs">
            <li>
              <a href="/airport/recommend/" class="flex items-center justify-between text-ink-body hover:text-brand-600">
                <span>• 2026 综合机场推荐</span>
                <span class="text-[10px] text-ink-muted">专线标杆</span>
              </a>
            </li>
            <li>
              <a href="/airport/cost-effective/" class="flex items-center justify-between text-ink-body hover:text-brand-600">
                <span>• 高性价比机场选购指南</span>
                <span class="text-[10px] text-ink-muted">¥10起</span>
              </a>
            </li>
            <li>
              <a href="/clash/verge-download/" class="flex items-center justify-between text-ink-body hover:text-brand-600">
                <span>• Clash Verge 全平台下载</span>
                <span class="text-[10px] text-emerald-600">官方发布</span>
              </a>
            </li>
            <li>
              <a href="/resources/runaway-warning/" class="flex items-center justify-between text-ink-body hover:text-brand-600">
                <span>• 机场跑路预警与黑名单</span>
                <span class="text-[10px] text-rose-600">避坑必看</span>
              </a>
            </li>
            <li>
              <a href="/brands/" class="flex items-center justify-between text-ink-body hover:text-brand-600">
                <span>• 41家机场品牌数据库</span>
                <span class="text-[10px] text-brand-600">参数筛选</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- Safe usage notice -->
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 text-[11px] text-slate-500 leading-relaxed">
          <strong>防坑提示：</strong>避免一次性大额购买年付或多年付小作坊套餐。建议优先月付或选择运营超3年的老牌专线服务商。
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
