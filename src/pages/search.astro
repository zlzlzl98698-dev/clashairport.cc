---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';

const breadcrumbs = [
  { title: '全站搜索', href: '/search/' },
];
---

<BaseLayout
  title="站内全文检索 - 机场测评·客户端教程·故障排查 - clash机机"
  description="clash机机站内全文搜索中心。快速检索 41+ 机场品牌评测、测速数据、流媒体与 ChatGPT 原生解锁技巧、Clash Verge 客户端全平台下载及节点故障排查指南。"
  canonical="https://clashairport.cc/search/"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumb items={breadcrumbs} />

    <header class="mb-8 text-center">
      <div class="w-12 h-12 mx-auto rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center text-xl mb-3 shadow-sm">
        🔍
      </div>
      <h1 class="text-3xl font-extrabold text-ink-title tracking-tight mb-2">
        站内全文检索系统
      </h1>
      <p class="text-xs text-ink-muted max-w-md mx-auto">
        基于 Pagefind 静态全文检索技术。支持中文分词、高亮关键词摘要及秒级离线索引响应。
      </p>
    </header>

    <!-- Pagefind Container -->
    <div class="card-base p-6 sm:p-8 bg-white border-surface-border shadow-sm min-h-[400px]">
      <div id="search"></div>
    </div>

    <!-- Quick Searches -->
    <div class="mt-8 text-center text-xs text-ink-muted space-x-2">
      <span>热门搜索：</span>
      <a href="/search/?q=光速云" class="hover:text-brand-600 underline">光速云</a>
      <span>•</span>
      <a href="/search/?q=Clash+Verge" class="hover:text-brand-600 underline">Clash Verge</a>
      <span>•</span>
      <a href="/search/?q=IEPL" class="hover:text-brand-600 underline">IEPL专线</a>
      <span>•</span>
      <a href="/search/?q=跑路" class="hover:text-brand-600 underline">跑路预警</a>
      <span>•</span>
      <a href="/search/?q=性价比" class="hover:text-brand-600 underline">性价比机场</a>
    </div>
  </div>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script src="/pagefind/pagefind-ui.js" is:inline></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (typeof PagefindUI !== 'undefined') {
        new PagefindUI({
          element: '#search',
          showSubResults: true,
          showImages: false,
          translations: {
            placeholder: '输入关键词搜索文章、测速报告或客户端教程...',
            clear_search: '清空',
            load_more: '加载更多结果',
            search_label: '搜索此站点',
            filters_label: '筛选',
            zero_results: '未找到与 "[SEARCH_TERM]" 相关的结果',
            many_results: '找到 [COUNT] 条与 "[SEARCH_TERM]" 相关的结果',
            one_result: '找到 1 条与 "[SEARCH_TERM]" 相关的结果',
            alt_search: '未找到与 "[SEARCH_TERM]" 相关的内容。显示 [DIFFERENT_TERM] 的搜索结果',
            search_suggestion: '您是否要搜索：[SEARCH_TERM]',
            searching: '正在检索站内索引...',
          },
        });

        // Auto query from URL param ?q=
        const urlParams = new URLSearchParams(window.location.search);
        const query = urlParams.get('q');
        if (query) {
          const input = document.querySelector('.pagefind-ui__search-input');
          if (input) {
            input.value = query;
            input.dispatchEvent(new Event('input', { bubbles: true }));
          }
        }
      }
    });
  </script>
</BaseLayout>
