---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MAIN_NAVIGATION } from '../data/navigation';
---

<BaseLayout
  title="404 - 页面未找到 - clash机机"
  description="抱歉，您访问的页面不存在或已被移除。您可以返回首页或浏览以下热门评测专题。"
  noindex={true}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <div class="w-20 h-20 mx-auto rounded-3xl bg-brand-50 text-brand-600 flex items-center justify-center text-3xl font-black mb-6 shadow-sm border border-brand-100">
      404
    </div>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-ink-title tracking-tight mb-3">
      抱歉，该页面似乎在跨境传输中走失了
    </h1>

    <p class="text-sm text-ink-muted leading-relaxed max-w-md mx-auto mb-8">
      您请求的 URL 链接不存在、已被迁移，或正在进行内容版本重构。请尝试使用下方搜索功能或直接访问重点专题。
    </p>

    <div class="flex items-center justify-center gap-3 mb-12 flex-wrap">
      <a
        href="/"
        class="px-6 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs shadow-md transition-all"
      >
        返回网站首页
      </a>
      <a
        href="/search/"
        class="px-6 py-2.5 rounded-xl bg-white hover:bg-surface-subtle text-ink-title font-semibold text-xs border border-surface-border shadow-sm transition-colors"
      >
        使用站内搜索
      </a>
      <a
        href="/brands/"
        class="px-6 py-2.5 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-semibold text-xs border border-emerald-200 transition-colors"
      >
        查看41家品牌库
      </a>
    </div>

    <!-- Quick Sections Matrix -->
    <div class="card-base p-6 bg-surface-subtle border-surface-border text-left">
      <h3 class="text-xs font-bold text-ink-title uppercase tracking-wider mb-4 pb-2 border-b border-surface-border">
        您可以探索以下四大主要栏目：
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs">
        {MAIN_NAVIGATION.map((sec) => (
          <div>
            <a href={sec.href} class="font-bold text-brand-600 hover:underline block mb-2">
              {sec.title} »
            </a>
            <ul class="space-y-1 text-ink-muted text-[11px]">
              {sec.subItems.slice(0, 4).map((sub) => (
                <li>
                  <a href={sub.href} class="hover:text-ink-title">
                    {sub.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
