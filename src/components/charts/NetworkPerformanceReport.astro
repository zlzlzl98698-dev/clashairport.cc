---
interface NodeSpeed {
  nodeName: string;
  latency: string;
  downloadSpeed: string;
  percentage: number;
  statusColor: string;
}

interface Props {
  brandName?: string;
  testDate?: string;
  clientEnv?: string;
  nodes?: NodeSpeed[];
  summaryLatency?: string;
  summarySpeed?: string;
  lossRate?: string;
  dataSource?: string;
}

const {
  brandName = '光速云 (LightSpeed)',
  testDate = '2026-10-19 晚高峰 20:30 CST',
  clientEnv = 'Clash Verge Rev v1.7.x (Mihomo Kernel) | 广州电信 1000M',
  nodes = [
    { nodeName: '香港 01 IEPL 企业专线', latency: '22ms', downloadSpeed: '529 Mbps', percentage: 95, statusColor: 'bg-emerald-400' },
    { nodeName: '日本 东京 01 IEPL 专线', latency: '57ms', downloadSpeed: '385 Mbps', percentage: 75, statusColor: 'bg-emerald-400' },
    { nodeName: '新加坡 01 BGP 极速中转', latency: '46ms', downloadSpeed: '387 Mbps', percentage: 76, statusColor: 'bg-emerald-400' },
    { nodeName: '台湾 台北 01 原生专线', latency: '41ms', downloadSpeed: '280 Mbps', percentage: 65, statusColor: 'bg-emerald-400' },
    { nodeName: '美国 洛杉矶 01 优化回程', latency: '143ms', downloadSpeed: '120 Mbps', percentage: 40, statusColor: 'bg-amber-400' },
  ],
  summaryLatency = '平均延迟 48ms',
  summarySpeed = '峰值下行 529 Mbps',
  lossRate = '0.0% 丢包',
  dataSource = '网络可观测性实验室真机拔测 (非商家宣称值)',
} = Astro.props;
---

<div class="my-8 rounded-2xl bg-slate-900 border border-slate-800 text-slate-100 overflow-hidden shadow-elevated font-sans">
  <!-- Observatory Header -->
  <div class="px-6 py-4 bg-slate-950/80 border-b border-slate-800 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <div class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></div>
      <div>
        <h4 class="text-sm font-bold text-white tracking-wide flex items-center gap-2">
          <span>🌐 {brandName} 网络性能拔测报告</span>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800">
            MEASURED DATA
          </span>
        </h4>
        <p class="text-xs text-slate-400 mt-0.5 font-mono">{testDate}</p>
      </div>
    </div>
    <div class="text-xs text-slate-400 font-mono text-right">
      <span>测试环境: {clientEnv}</span>
    </div>
  </div>

  <!-- Performance Node Bars -->
  <div class="p-6 space-y-5">
    {nodes.map((node) => (
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-xs">
          <div class="flex items-center gap-2 font-mono">
            <span class={`w-2 h-2 rounded-full ${node.statusColor}`}></span>
            <span class="font-medium text-slate-200">{node.nodeName}</span>
          </div>
          <div class="flex items-center gap-4 font-mono text-slate-300">
            <span>延迟: <strong class="text-emerald-400">{node.latency}</strong></span>
            <span>下行: <strong class="text-cyan-400">{node.downloadSpeed}</strong></span>
          </div>
        </div>
        <!-- Bar Indicator -->
        <div class="w-full h-3 bg-slate-800 rounded-full overflow-hidden p-0.5">
          <div
            class="h-full rounded-full bg-gradient-to-r from-blue-500 via-cyan-400 to-emerald-400 transition-all duration-1000"
            style={`width: ${node.percentage}%`}
          ></div>
        </div>
      </div>
    ))}
  </div>

  <!-- Summary Footer -->
  <div class="px-6 py-3.5 bg-slate-950/90 border-t border-slate-800 flex flex-wrap items-center justify-between gap-2 text-xs font-mono text-slate-400">
    <div class="flex items-center gap-4 flex-wrap">
      <span class="text-slate-300">汇总指标:</span>
      <span class="text-emerald-400 font-semibold">{summaryLatency}</span>
      <span>|</span>
      <span class="text-cyan-400 font-semibold">{summarySpeed}</span>
      <span>|</span>
      <span class="text-emerald-400 font-semibold">{lossRate}</span>
    </div>
    <div class="text-[11px] text-slate-500">
      <span>[来源: {dataSource}]</span>
    </div>
  </div>
</div>
