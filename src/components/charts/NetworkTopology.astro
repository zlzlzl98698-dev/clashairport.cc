---
interface Props {
  brandName?: string;
  lineType?: string;
}

const {
  brandName = '光速云',
  lineType = 'IEPL 专线 + 企业级内网专线双架构',
} = Astro.props;
---

<div class="my-8 rounded-2xl bg-slate-900 border border-slate-800 text-slate-100 overflow-hidden shadow-elevated">
  <!-- Header -->
  <div class="px-6 py-4 bg-slate-950/80 border-b border-slate-800 flex items-center justify-between">
    <div>
      <h4 class="text-sm font-bold text-white tracking-wide flex items-center gap-2">
        <span>🗺️ {brandName} 网络拓扑与跨境路由架构 (Network Topology)</span>
      </h4>
      <p class="text-xs text-slate-400 mt-0.5">线路类型: {lineType}</p>
    </div>
    <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-blue-950 text-blue-400 border border-blue-800">
      IEPL DUAL TUNNEL
    </span>
  </div>

  <!-- Diagram Visual -->
  <div class="p-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-center">
      
      <!-- Stage 1: User Client -->
      <div class="bg-slate-800/80 rounded-xl p-4 border border-slate-700 text-center">
        <div class="w-10 h-10 mx-auto rounded-lg bg-blue-600/20 text-blue-400 flex items-center justify-center mb-2">
          📱 💻
        </div>
        <div class="text-xs font-bold text-slate-100 mb-1">终端设备</div>
        <div class="text-[11px] text-slate-400">PC / 手机 / 软路由</div>
        <div class="text-[10px] font-mono text-cyan-400 mt-1">Clash Verge / VLESS</div>
      </div>

      <!-- Arrow 1 -->
      <div class="hidden md:flex flex-col items-center justify-center text-slate-500 font-mono text-xs">
        <span>加密连接</span>
        <span class="text-blue-400 text-lg">──▶</span>
        <span class="text-[10px]">TLS 1.3</span>
      </div>

      <!-- Stage 2: Ingress Entry -->
      <div class="bg-slate-800/80 rounded-xl p-4 border border-slate-700 text-center">
        <div class="w-10 h-10 mx-auto rounded-lg bg-indigo-600/20 text-indigo-400 flex items-center justify-center mb-2">
          🏢 ⚡
        </div>
        <div class="text-xs font-bold text-slate-100 mb-1">国内 BGP 入口</div>
        <div class="text-[11px] text-slate-400">广州 / 上海 多线 BGP</div>
        <div class="text-[10px] font-mono text-indigo-400 mt-1">智能故障转移调度</div>
      </div>

      <!-- Arrow 2 (Dedicated Line) -->
      <div class="hidden md:flex flex-col items-center justify-center text-emerald-400 font-mono text-xs">
        <span class="font-bold">IEPL 物理专线</span>
        <span class="text-emerald-400 text-lg">════▶</span>
        <span class="text-[10px] text-emerald-300">0% 丢包 / 无公网审查</span>
      </div>

      <!-- Stage 3: Overseas Landing -->
      <div class="bg-slate-800/80 rounded-xl p-4 border border-slate-700 text-center md:col-start-3 md:row-start-2">
        <div class="w-10 h-10 mx-auto rounded-lg bg-emerald-600/20 text-emerald-400 flex items-center justify-center mb-2">
          🌏 🛰️
        </div>
        <div class="text-xs font-bold text-slate-100 mb-1">海外落地出口</div>
        <div class="text-[11px] text-slate-400">香港 / 日本 / 新加坡 / 美国</div>
        <div class="text-[10px] font-mono text-emerald-400 mt-1">高信誉原生住宅 IP 池</div>
      </div>

      <!-- Arrow 3 -->
      <div class="hidden md:flex flex-col items-center justify-center text-slate-500 font-mono text-xs md:col-start-4 md:row-start-2">
        <span>高速分流</span>
        <span class="text-cyan-400 text-lg">──▶</span>
        <span class="text-[10px]">SmartDNS 解锁</span>
      </div>

      <!-- Stage 4: Target Services -->
      <div class="bg-slate-800/80 rounded-xl p-4 border border-slate-700 text-center md:col-start-4 md:row-start-1">
        <div class="w-10 h-10 mx-auto rounded-lg bg-purple-600/20 text-purple-400 flex items-center justify-center mb-2">
          🌐 🤖
        </div>
        <div class="text-xs font-bold text-slate-100 mb-1">目标网络服务</div>
        <div class="text-[11px] text-slate-400">ChatGPT / Netflix / YouTube</div>
        <div class="text-[10px] font-mono text-purple-400 mt-1">全速跑满千兆</div>
      </div>

    </div>
  </div>

  <!-- Tech Notes -->
  <div class="px-6 py-3.5 bg-slate-950/90 border-t border-slate-800 text-xs text-slate-400 font-mono flex items-center justify-between">
    <span>物理光纤内网互联，全程规避公网国际出口拥堵与 QoS 限速。</span>
    <span class="text-slate-500">[clash机机网络架构实测]</span>
  </div>
</div>
