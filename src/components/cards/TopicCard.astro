---
interface Props {
  title: string;
  description: string;
  href: string;
  subItems?: { title: string; href: string }[];
  iconName?: string;
  badge?: string;
}

const {
  title,
  description,
  href,
  subItems = [],
  iconName = 'compass',
  badge,
} = Astro.props;
---

<div class="card-base group p-6 bg-white hover:border-brand-300 flex flex-col justify-between">
  <div>
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center group-hover:scale-110 transition-transform shadow-sm">
        {iconName === 'compass' && (
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        )}
        {iconName === 'shield' && (
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        )}
        {iconName === 'terminal' && (
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        )}
        {iconName === 'database' && (
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
          </svg>
        )}
      </div>
      {badge && (
        <span class="px-2.5 py-0.5 text-xs font-semibold rounded-full bg-brand-50 text-brand-700 border border-brand-200">
          {badge}
        </span>
      )}
    </div>

    <h3 class="text-lg font-bold text-ink-title mb-2 group-hover:text-brand-600 transition-colors">
      <a href={href}>{title}</a>
    </h3>

    <p class="text-xs text-ink-muted leading-relaxed mb-4">
      {description}
    </p>

    {subItems.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-5 pt-3 border-t border-surface-border">
        {subItems.slice(0, 6).map((sub) => (
          <a
            href={sub.href}
            class="text-[11px] font-medium px-2 py-0.5 rounded bg-surface-subtle hover:bg-brand-50 hover:text-brand-600 text-ink-body transition-colors"
          >
            {sub.title}
          </a>
        ))}
      </div>
    )}
  </div>

  <div class="pt-3 border-t border-surface-border flex items-center justify-between">
    <a href={href} class="text-xs font-semibold text-brand-600 group-hover:text-brand-700 inline-flex items-center gap-1">
      进入专题中心
      <span class="group-hover:translate-x-1 transition-transform">→</span>
    </a>
    <span class="text-[11px] text-ink-muted">7个二级子专题</span>
  </div>
</div>
