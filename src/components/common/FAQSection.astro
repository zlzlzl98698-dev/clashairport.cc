---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQItem[];
  title?: string;
  description?: string;
}

const {
  faqs,
  title = '常见问题排查与避坑解答 (FAQ)',
  description = '基于真实出海用户高频咨询与实验室拔测经验总结',
} = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<div class="my-10">
  <div class="mb-6">
    <h3 class="text-xl font-bold text-ink-title flex items-center gap-2">
      <span>❓ {title}</span>
    </h3>
    <p class="text-xs text-ink-muted mt-1">{description}</p>
  </div>

  <div class="space-y-3">
    {faqs.map((faq, idx) => (
      <details class="group bg-white rounded-xl border border-surface-border p-4 transition-all duration-200 hover:border-brand-300">
        <summary class="flex items-center justify-between cursor-pointer list-none text-sm font-bold text-ink-title select-none">
          <span class="flex items-center gap-2">
            <span class="text-brand-600 font-mono text-xs">Q{idx + 1}.</span>
            {faq.question}
          </span>
          <span class="text-ink-muted text-xs transition-transform duration-200 group-open:rotate-180">
            ▼
          </span>
        </summary>
        <div class="mt-3 pt-3 border-t border-surface-border text-xs text-ink-body leading-relaxed pl-6">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</div>
