---
import { MAIN_NAVIGATION } from '../../data/navigation';
import { SITE } from '../../data/site';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md border-b border-surface-border transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Brand Logo -->
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5 group" aria-label="clash机机 首页">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-brand-500 flex items-center justify-center text-white shadow-md shadow-brand-500/20 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 2L11 13"></path>
              <path d="M22 2L15 22L11 13L2 9L22 2Z"></path>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-bold tracking-tight text-ink-title flex items-center gap-1.5">
              clash机机
              <span class="text-[10px] font-semibold uppercase px-1.5 py-0.5 rounded bg-brand-50 text-brand-700 border border-brand-200">
                PRO
              </span>
            </span>
            <span class="text-[11px] text-ink-muted -mt-1 hidden sm:inline">
              中文机场与 VPN 专业评测媒体
            </span>
          </div>
        </a>
      </div>

      <!-- Desktop Four Main Navs -->
      <nav class="hidden lg:flex items-center space-x-1" aria-label="全站主导航">
        {MAIN_NAVIGATION.map((section) => {
          const isActive = currentPath.startsWith(section.href);
          return (
            <div class="relative group">
              <a
                href={section.href}
                class={`flex items-center gap-1 px-3.5 py-2 rounded-lg text-sm font-medium transition-colors ${
                  isActive
                    ? 'text-brand-600 bg-brand-50'
                    : 'text-ink-body hover:text-brand-600 hover:bg-surface-subtle'
                }`}
              >
                <span>{section.title}</span>
                <svg class="w-4 h-4 text-ink-muted group-hover:text-brand-600 transition-transform group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>

              <!-- Dropdown Menu -->
              <div class="absolute left-0 top-full pt-2 w-72 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 ease-out z-50">
                <div class="bg-white rounded-xl shadow-elevated border border-surface-border p-2 space-y-0.5">
                  <div class="px-3 py-2 border-b border-surface-border mb-1">
                    <p class="text-xs font-semibold text-ink-muted uppercase tracking-wider">{section.title} 核心专题</p>
                    <p class="text-xs text-ink-body mt-0.5">{section.description}</p>
                  </div>
                  {section.subItems.map((item) => (
                    <a
                      href={item.href}
                      class="flex items-center justify-between px-3 py-2 rounded-lg text-xs font-medium text-ink-body hover:text-brand-600 hover:bg-brand-50/60 transition-colors"
                    >
                      <span>{item.title}</span>
                      <span class="text-[11px] text-ink-muted group-hover:text-brand-500">→</span>
                    </a>
                  ))}
                  <div class="pt-1 border-t border-surface-border mt-1">
                    <a
                      href={section.href}
                      class="block text-center px-3 py-1.5 text-xs font-semibold text-brand-600 hover:text-brand-700 bg-brand-50 rounded-md"
                    >
                      查看全部 {section.title} 内容 →
                    </a>
                  </div>
                </div>
              </div>
            </div>
          );
        })}

        <!-- Brand Database Button -->
        <a
          href="/brands/"
          class={`flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-sm font-semibold transition-colors ${
            currentPath.startsWith('/brands/')
              ? 'text-brand-600 bg-brand-50'
              : 'text-ink-body hover:text-brand-600 hover:bg-surface-subtle'
          }`}
        >
          <span>品牌数据库</span>
          <span class="inline-flex items-center px-1.5 py-0.2 text-[10px] font-bold rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
            41家实测
          </span>
        </a>
      </nav>

      <!-- Right Utility Controls -->
      <div class="flex items-center gap-3">
        <!-- Search Trigger Button -->
        <a
          href="/search/"
          class="flex items-center gap-2 px-3 py-1.5 text-xs text-ink-muted bg-surface-subtle hover:bg-surface-hover border border-surface-border rounded-lg transition-colors group"
          title="全站搜索"
        >
          <svg class="w-4 h-4 text-ink-muted group-hover:text-brand-600" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
          </svg>
          <span class="hidden md:inline">站内搜索...</span>
          <kbd class="hidden md:inline-block px-1.5 py-0.5 text-[10px] font-mono text-ink-muted bg-white rounded border border-surface-border">⌘K</kbd>
        </a>

        <!-- Primary Featured Aff Direct Link (光速云) -->
        <a
          href="https://sahude.gsyvipaff.com/#/?code=keqgvT5Y"
          target="_blank"
          rel="nofollow sponsored noopener"
          class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-bold text-white bg-brand-600 hover:bg-brand-700 rounded-lg shadow-sm shadow-brand-600/20 transition-all hover:scale-[1.02]"
        >
          <span>光速云特惠</span>
          <span class="text-[10px] bg-brand-700 px-1 py-0.2 rounded">8元起</span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="lg:hidden p-2 rounded-lg text-ink-body hover:bg-surface-subtle focus:outline-none"
          aria-label="展开手机菜单"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-surface-border bg-white px-4 pt-3 pb-6 space-y-4 max-h-[80vh] overflow-y-auto">
    <div class="space-y-1">
      <a href="/" class="block px-3 py-2 rounded-md text-base font-semibold text-ink-title hover:bg-surface-subtle">
        首页 (Home)
      </a>
      <a href="/brands/" class="flex items-center justify-between px-3 py-2 rounded-md text-base font-semibold text-brand-600 hover:bg-brand-50">
        <span>品牌数据库 (41家实测)</span>
        <span class="text-xs bg-brand-100 text-brand-700 px-2 py-0.5 rounded-full">库</span>
      </a>
    </div>

    {MAIN_NAVIGATION.map((section) => (
      <div class="border-t border-surface-border pt-3">
        <a href={section.href} class="flex items-center justify-between px-3 py-1.5 text-sm font-bold text-ink-title">
          <span>{section.title}</span>
          <span class="text-xs text-brand-600">全部 →</span>
        </a>
        <div class="grid grid-cols-2 gap-1 mt-1 pl-2">
          {section.subItems.map((item) => (
            <a
              href={item.href}
              class="px-2 py-1.5 text-xs text-ink-muted hover:text-brand-600 hover:bg-surface-subtle rounded"
            >
              {item.title}
            </a>
          ))}
        </div>
      </div>
    ))}

    <div class="pt-4 border-t border-surface-border flex flex-col gap-2">
      <a
        href="https://sahude.gsyvipaff.com/#/?code=keqgvT5Y"
        target="_blank"
        rel="nofollow sponsored noopener"
        class="w-full text-center py-2.5 px-4 text-sm font-bold text-white bg-brand-600 hover:bg-brand-700 rounded-lg shadow-sm"
      >
        商业主推：光速云官网特惠入口 (8元起)
      </a>
      <a
        href="/search/"
        class="w-full text-center py-2 px-4 text-xs font-medium text-ink-body bg-surface-subtle border border-surface-border rounded-lg"
      >
        站内全文检索 (Pagefind)
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }

  // Keyboard shortcut for search
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      window.location.href = '/search/';
    }
  });
</script>
