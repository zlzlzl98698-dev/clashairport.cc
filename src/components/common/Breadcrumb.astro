---
interface BreadcrumbItem {
  title: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const breadcrumbsList = [
  { title: '首页', href: '/' },
  ...items,
];

const schemaItems = breadcrumbsList.map((item, index) => ({
  '@type': 'ListItem',
  position: index + 1,
  name: item.title,
  ...(item.href ? { item: `https://clashairport.cc${item.href}` } : {}),
}));

const schemaJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: schemaItems,
});
---

<nav aria-label="面包屑导航" class="my-4">
  <ol class="flex items-center flex-wrap gap-1.5 text-xs text-ink-muted">
    {breadcrumbsList.map((item, idx) => {
      const isLast = idx === breadcrumbsList.length - 1;
      return (
        <li class="flex items-center gap-1.5">
          {idx > 0 && <span class="text-surface-border text-slate-300">/</span>}
          {isLast || !item.href ? (
            <span class="text-ink-title font-medium truncate max-w-[200px] sm:max-w-xs" aria-current="page">
              {item.title}
            </span>
          ) : (
            <a href={item.href} class="hover:text-brand-600 transition-colors">
              {item.title}
            </a>
          )}
        </li>
      );
    })}
  </ol>
  <script type="application/ld+json" set:html={schemaJson}></script>
</nav>
