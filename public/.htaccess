# ====================================================================
# Apache Configuration for clashairport.cc (Astro Static Site)
# ====================================================================

# Disable directory listing
Options -Indexes

# Follow symbolic links
Options +FollowSymLinks

# Default directory index
DirectoryIndex index.html

# Custom 404 Error Page
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force non-www canonical domain (301)
  RewriteCond %{HTTP_HOST} ^www\.clashairport\.cc$ [NC]
  RewriteRule ^(.*)$ https://clashairport.cc/$1 [R=301,L]

  # 2. Respect Reverse Proxy / Cloudflare / CDN HTTPS forwarding (301)
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [NC,OR]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://clashairport.cc/$1 [R=301,L]

  # Redirect legacy .html URLs to clean directory URLs
  RewriteCond %{REQUEST_URI} !^/404\.html$ [NC]
  RewriteRule ^(.*)\.html$ /$1/ [R=301,L]

  # 2. Prevent rewrite loops on actual existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Map /sitemap.xml to /sitemap-index.xml
  RewriteRule ^sitemap\.xml$ /sitemap-index.xml [L]

  # 3. Handle trailing slash directory mapping for static HTML files
  # e.g., /airport/ -> /airport/index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/$ $1/index.html [L]

  # e.g., /airport -> /airport/index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # e.g., /about -> /about.html
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Caching Configuration
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML files - revalidate frequently
  ExpiresByType text/html "access plus 1 hour"

  # CSS, JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Images, Icons
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Web fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# Gzip / Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
